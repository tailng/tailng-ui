{
  "name": "flow",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tailng-ui/flow/src",
  "prefix": "tng",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:tailng", "type:flow"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/libs/tailng-ui/flow"],
      "options": {
        "project": "libs/tailng-ui/flow/ng-package.json",
        "tsConfig": "libs/tailng-ui/flow/tsconfig.lib.prod.json"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "vite:test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "libs/tailng-ui/flow/vitest.config.ts",
        "reportsDirectory": "coverage/libs/tailng-ui/flow",
        "watch": false
      }
    },
    "browser-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "vitest run --config libs/tailng-ui/flow/vitest.browser.config.ts"
      }
    }
  }
}
